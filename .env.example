APP_NAME=Voice Fairy Tale
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
AUTH_MODE=development_header
TRUSTED_PROXY_SECRET=
RATE_LIMIT_REQUESTS_PER_MINUTE=120
READINESS_REQUIRE_REDIS=false
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGINS=["http://localhost:3000","http://localhost:5173"]

DATABASE_URL=postgresql+asyncpg://voice:voice@database:5432/voice
REDIS_URL=redis://redis:6379/0
STORAGE_PATH=/data/storage
MODEL_PATH=/data/models
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CUDA_DEVICE=cuda:0
MAX_UPLOAD_SIZE=524288000
MAX_AUDIO_DURATION_SECONDS=3600
VOICE_CONSENT_VERSION=2026-09-01
MIN_VOICE_PROFILE_SPEECH_SECONDS=10
MODEL_CACHE_LIMIT=2
GPU_VRAM_RESERVE_MB=512
SSE_POLL_INTERVAL_SECONDS=1
SSE_HEARTBEAT_SECONDS=15
USE_MOCK_INFERENCE=true
ENABLE_COSYVOICE3=false
COSYVOICE_RUNTIME_PATH=./models/cosyvoice-runtime
COSYVOICE_CHECKPOINT_PATH=./models/cosyvoice3-0.5b-2512
COSYVOICE_FP16=true
TEMP_RETENTION_HOURS=24
INPUT_RETENTION_HOURS=24
OUTPUT_RETENTION_HOURS=168
CLEANUP_BATCH_SIZE=100
ORPHAN_GRACE_HOURS=2

POSTGRES_DB=voice
POSTGRES_USER=voice
POSTGRES_PASSWORD=change-me

